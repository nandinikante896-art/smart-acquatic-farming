# Optional: enables the Gemini-backed /api/assistant endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Farmer Dashboard settings. If left empty, create the account once
# from the Farmer Dashboard while using AquaCare on this computer.
FARMER_USERNAME=
FARMER_PASSWORD=
AQUACARE_SECRET_KEY=
# Set to 1 only when AquaCare is served over HTTPS.
AQUACARE_COOKIE_SECURE=0
